# Copiez ce fichier en .env et adaptez les valeurs. Ne commitez jamais .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
# Domaines/IP autorisés à servir l'app (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.212,geneam.home.3airdutemps.fr
# Origines de confiance pour le CSRF (avec schéma http:// ou https://)
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://192.168.1.212,https://192.168.1.212,https://geneam.home.3airdutemps.fr

# --- Compte administrateur créé automatiquement au premier démarrage ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Base de données PostgreSQL ---
POSTGRES_DB=geneam
POSTGRES_USER=geneam
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
